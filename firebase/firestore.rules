rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // HELPER FUNCTIONS & RBAC GUARDS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return getUserDoc(request.auth.uid);
    }

    function isTeacherOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['fikriya90@gmail.com', 'fikri.yassaar15@guru.smp.belajar.id'] ||
        (hasUserDoc() && currentUserData().role in ['Guru Pembina', 'Admin', 'Super Admin'])
      );
    }

    function isPimprod() {
      return hasUserDoc() && currentUserData().role == 'Pimpinan Produksi';
    }

    function isSutradara() {
      return hasUserDoc() && currentUserData().role == 'Sutradara';
    }

    function isAsisten() {
      return hasUserDoc() && currentUserData().role == 'Asisten Sutradara';
    }

    function isKoordinator() {
      return hasUserDoc() && currentUserData().role.matches('^Koordinator .*');
    }

    function isSameClass(classId) {
      return isTeacherOrAdmin() || (hasUserDoc() && currentUserData().classId == classId);
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Students can only read users within their own class; Teachers/Admins can read all
      allow read: if isSignedIn() && (
        isTeacherOrAdmin() ||
        isOwner(userId) ||
        (hasUserDoc() && resource.data.classId == currentUserData().classId)
      );

      // Registration: User creates their own profile. Cannot self-assign elevated roles.
      allow create: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.uid == request.auth.uid &&
          !(request.resource.data.role in ['Guru Pembina', 'Admin', 'Super Admin'])
        )
      );

      // Update: User cannot change their own 'role', 'classId', or 'uid' (only teacher can)
      allow update: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.classId == resource.data.classId &&
          request.resource.data.uid == resource.data.uid
        )
      );

      // Only teacher or admin can delete users
      allow delete: if isTeacherOrAdmin();
    }

    // ==========================================
    // 2. CLASSES COLLECTION
    // ==========================================
    match /classes/{classId} {
      // Authenticated users can read classes to select their class
      allow read: if isSignedIn();
      // Only teacher/admin can manage classes
      allow write: if isTeacherOrAdmin();
    }

    // ==========================================
    // 3. PRODUCTIONS COLLECTION
    // ==========================================
    match /productions/{productionId} {
      allow read: if isSignedIn() && isSameClass(resource.data.classId);
      allow create: if isSignedIn() && isSameClass(request.resource.data.classId) && (
        isTeacherOrAdmin() || isPimprod() || isSutradara()
      );
      allow update: if isSignedIn() && isSameClass(resource.data.classId) && (
        isTeacherOrAdmin() || isPimprod() || isSutradara()
      );
      allow delete: if isTeacherOrAdmin();
    }

    // ==========================================
    // 4. TASKS & DEADLINES COLLECTION
    // ==========================================
    match /tasks/{taskId} {
      // Strict class isolation
      allow read: if isSignedIn() && isSameClass(resource.data.classId);

      // Creation allowed by Teacher, Pimprod, Sutradara, or Koordinator within their class
      allow create: if isSignedIn() && isSameClass(request.resource.data.classId) && (
        isTeacherOrAdmin() || isPimprod() || isSutradara() || isKoordinator()
      );

      // Updates:
      // - Teacher / Pimprod can update anything
      // - Koordinator can update tasks of their division
      // - Assignee student can submit proof and update status to 'SUBMITTED' or progress (cannot approve own task)
      allow update: if isSignedIn() && isSameClass(resource.data.classId) && (
        isTeacherOrAdmin() ||
        isPimprod() ||
        (isKoordinator() && resource.data.divisionName == currentUserData().divisionName) ||
        (
          resource.data.assigneeId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proofUrl', 'proofNote', 'status', 'progress', 'updatedAt']) &&
          request.resource.data.status != 'APPROVED'
        )
      );

      allow delete: if isTeacherOrAdmin() || isPimprod();
    }

    // ==========================================
    // 5. ASSESSMENTS COLLECTION
    // ==========================================
    match /assessments/{assessmentId} {
      // Reading: Student can read their own received assessments or teacher/committee
      allow read: if isSignedIn() && isSameClass(resource.data.classId) && (
        isTeacherOrAdmin() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.assessorId == request.auth.uid ||
        isPimprod()
      );

      // Strict Anti-Bias Rule: NEVER assess yourself!
      // Must belong to the same class
      allow create: if isSignedIn() &&
        isSameClass(request.resource.data.classId) &&
        request.resource.data.assessorId == request.auth.uid &&
        request.resource.data.studentId != request.auth.uid &&
        (
          isTeacherOrAdmin() ||
          // Pimprod can assess Sekretaris, Bendahara, Koordinator
          (isPimprod() && request.resource.data.studentRole in ['Sekretaris', 'Bendahara', 'Koordinator Perlengkapan', 'Koordinator Publikasi', 'Koordinator Tata Panggung', 'Koordinator Tata Rias', 'Koordinator Tata Busana', 'Koordinator Tata Musik']) ||
          // Sutradara assesses Players & Assistant
          (isSutradara() && (request.resource.data.studentRole == 'Pemain' || request.resource.data.studentRole == 'Asisten Sutradara')) ||
          // Assistant Director assesses Players
          (isAsisten() && request.resource.data.studentRole == 'Pemain') ||
          // Coordinator assesses members of their division
          (isKoordinator() && request.resource.data.studentDivision == currentUserData().divisionName) ||
          // Peer assessment among actors or division members
          (request.resource.data.assessorType == 'REKAN')
        );

      // Updates: only creator (if not locked) or Teacher
      allow update: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (
          resource.data.assessorId == request.auth.uid &&
          resource.data.studentId != request.auth.uid &&
          resource.data.isFinal == false
        )
      );

      allow delete: if isTeacherOrAdmin();
    }

    // ==========================================
    // 6. ATTENDANCE SESSIONS & RECORDS
    // ==========================================
    match /attendanceSessions/{sessionId} {
      allow read: if isSignedIn() && isSameClass(resource.data.classId);

      // Pimprod & Sekretaris: General attendance
      // Sutradara & Asisten: Rehearsal attendance (Actors + Music)
      // Koordinator: Division internal attendance
      allow create: if isSignedIn() && isSameClass(request.resource.data.classId) && (
        isTeacherOrAdmin() ||
        isPimprod() ||
        currentUserData().role == 'Sekretaris' ||
        ((isSutradara() || isAsisten()) && request.resource.data.targetScope == 'PEMAIN_MUSIK') ||
        (isKoordinator() && request.resource.data.targetScope == 'DIVISI' && request.resource.data.targetDivisionId == currentUserData().divisionId)
      );

      allow update: if isSignedIn() && (
        isTeacherOrAdmin() ||
        resource.data.createdBy == request.auth.uid
      );

      allow delete: if isTeacherOrAdmin() || resource.data.createdBy == request.auth.uid;
    }

    match /attendanceRecords/{recordId} {
      allow read: if isSignedIn() && isSameClass(resource.data.classId);

      // Student can check-in for themselves, or session creator/teacher can mark
      allow create, update: if isSignedIn() && isSameClass(request.resource.data.classId) && (
        isTeacherOrAdmin() ||
        request.resource.data.studentId == request.auth.uid
      );

      allow delete: if isTeacherOrAdmin();
    }

    // ==========================================
    // 7. SCHEDULES & CALENDAR
    // ==========================================
    match /schedules/{scheduleId} {
      allow read: if isSignedIn() && isSameClass(resource.data.classId);

      allow create: if isSignedIn() && isSameClass(request.resource.data.classId) && (
        isTeacherOrAdmin() || isPimprod() || currentUserData().role == 'Sekretaris' || isSutradara() || isAsisten() || isKoordinator()
      );

      allow update, delete: if isSignedIn() && (
        isTeacherOrAdmin() ||
        resource.data.createdBy == request.auth.uid
      );
    }

    // ==========================================
    // 8. NOTIFICATIONS & BROADCASTS
    // ==========================================
    match /notifications/{notificationId} {
      // User can only read and manage their own notifications
      allow read, update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isTeacherOrAdmin()
      );
      allow create: if isSignedIn();
    }

    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn() && isSameClass(resource.data.classId);
      allow create: if isSignedIn() && isSameClass(request.resource.data.classId) && (
        isTeacherOrAdmin() || isPimprod() || currentUserData().role == 'Sekretaris' || isSutradara() || isKoordinator()
      );
      allow update, delete: if isTeacherOrAdmin() || resource.data.senderId == request.auth.uid;
    }

    // ==========================================
    // 9. DOCUMENTS & ARCHIVES
    // ==========================================
    match /documents/{documentId} {
      allow read: if isSignedIn() && isSameClass(resource.data.classId);
      allow create: if isSignedIn() && isSameClass(request.resource.data.classId);
      allow update, delete: if isTeacherOrAdmin() || resource.data.uploadedBy == request.auth.uid;
    }

    // ==========================================
    // 10. COMPLAINTS & GRIEVANCES
    // ==========================================
    match /complaints/{complaintId} {
      // Students can read their own complaints; Teachers can read all in the class
      allow read: if isSignedIn() && (
        isTeacherOrAdmin() ||
        resource.data.studentId == request.auth.uid
      );

      allow create: if isSignedIn() && isSameClass(request.resource.data.classId) && (
        request.resource.data.studentId == request.auth.uid
      );

      allow update: if isSignedIn() && (
        isTeacherOrAdmin() ||
        (resource.data.studentId == request.auth.uid && resource.data.status == 'OPEN')
      );

      allow delete: if isTeacherOrAdmin();
    }

    // ==========================================
    // 11. PROMPT BOOKS (3x3 STAGE BLOCKING)
    // ==========================================
    match /promptBooks/{promptBookId} {
      allow read: if isSignedIn() && isSameClass(resource.data.classId);
      allow create, update: if isSignedIn() && isSameClass(request.resource.data.classId) && (
        isTeacherOrAdmin() || isSutradara() || isAsisten()
      );
      allow delete: if isTeacherOrAdmin();
    }

    // ==========================================
    // 12. AUDIT LOGS
    // ==========================================
    match /auditLogs/{logId} {
      // Only teachers and admins can view system audit logs
      allow read: if isTeacherOrAdmin();
      // Any authenticated user action can append an audit entry
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Audit logs are tamper-proof and immutable
      allow update, delete: if false;
    }

    // ==========================================
    // 13. CONNECTION HEALTHCHECK
    // ==========================================
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
