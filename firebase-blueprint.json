{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, assigned class(es), and production team division",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "classId": { "type": "string", "description": "Primary class (backward compat)" },
        "classIds": {
          "type": "array",
          "description": "Semua kelas yang diampu (untuk guru multi-kelas)",
          "items": { "type": "string" }
        },
        "className": { "type": "string" },
        "phone": { "type": "string", "description": "WAJIB untuk Guru Pengampu" },
        "productionId": { "type": "string" },
        "divisionId": { "type": "string" },
        "divisionName": { "type": "string" },
        "photoURL": { "type": "string" },
        "nis": { "type": "string" },
        "secondaryEmail": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "Class": {
      "title": "Class",
      "description": "School class participating in theater production",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "academicYear": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "totalStudents": { "type": "number" },
        "kerabatKerja": { "type": "string" },
        "kerabatLogo": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "Production": {
      "title": "Production",
      "description": "Theater production project for a class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "schoolYear": { "type": "string" },
        "status": { "type": "string" },
        "currentStage": { "type": "string" },
        "synopsis": { "type": "string" },
        "theme": { "type": "string" },
        "directorVision": { "type": "string" },
        "startDate": { "type": "string" },
        "performanceDate": { "type": "string" },
        "endDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "classId", "status", "currentStage"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Katalog alat sekolah (school-wide)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string", "description": "SCHOOL_WIDE untuk alat global" },
        "isSchoolWide": { "type": "boolean" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "condition": { "type": "string", "description": "BAIK | RUSAK_RINGAN | RUSAK_BERAT" },
        "notes": { "type": "string" },
        "isCustom": { "type": "boolean" },
        "addedByName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "quantity", "condition"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Peminjaman alat dengan multi-alat session, checkout/return tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string", "description": "Group ID untuk multi-alat booking" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "equipmentId": { "type": "string" },
        "equipmentName": { "type": "string" },
        "equipmentCategory": { "type": "string" },
        "bookedBy": { "type": "string" },
        "bookerName": { "type": "string" },
        "bookerRole": { "type": "string" },
        "bookerDivision": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string", "description": "PENDING | APPROVED | REJECTED | CANCELLED | CHECKED_OUT | RETURNED | OVERDUE" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "rejectionGuidance": { "type": "string" },
        "recommendedDate": { "type": "string" },
        "recommendedStartTime": { "type": "string" },
        "recommendedEndTime": { "type": "string" },
        "checkedOutAt": { "type": "string" },
        "checkoutPhotoUrl": { "type": "string" },
        "checkoutNote": { "type": "string" },
        "returnedAt": { "type": "string" },
        "returnPhotoUrl": { "type": "string" },
        "returnCondition": { "type": "string" },
        "returnNote": { "type": "string" },
        "isLateReturn": { "type": "boolean" },
        "cancelledAt": { "type": "string" },
        "cancelledBy": { "type": "string" },
        "cancelledReason": { "type": "string" },
        "verifierNote": { "type": "string" },
        "wasRescheduledByVerifier": { "type": "boolean" },
        "originalStartTime": { "type": "string" },
        "originalEndTime": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sessionId", "classId", "equipmentId", "bookedBy", "date", "status"]
    },
    "Task": {
      "title": "Task",
      "description": "Production task assignment and checklist item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "productionId": { "type": "string" },
        "stageId": { "type": "string" },
        "divisionId": { "type": "string" },
        "role": { "type": "string" },
        "assigneeId": { "type": "string" },
        "assigneeName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "progress": { "type": "number" },
        "dueDate": { "type": "string" },
        "proofUrl": { "type": "string" },
        "proofNote": { "type": "string" },
        "feedback": { "type": "string" },
        "isCritical": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "classId", "title", "status", "priority"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Evaluation record for a student across criteria and stages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "studentId": { "type": "string" },
        "assessorId": { "type": "string" },
        "assessorType": { "type": "string" },
        "stage": { "type": "string" },
        "scores": { "type": "object" },
        "totalScore": { "type": "number" },
        "comment": { "type": "string" },
        "isFinal": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "classId", "studentId", "assessorId", "stage", "totalScore"]
    },
    "AttendanceSession": {
      "title": "AttendanceSession",
      "description": "Attendance roll call session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "classId": { "type": "string" },
        "activityType": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string" },
        "targetScope": { "type": "string" },
        "createdBy": { "type": "string" },
        "creatorRole": { "type": "string" },
        "creatorName": { "type": "string" },
        "isOpen": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "classId", "activityType", "createdBy", "isOpen"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Student attendance entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "classId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "status": { "type": "string" },
        "note": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "sessionId", "studentId", "status"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Production calendar schedule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "classId": { "type": "string" },
        "type": { "type": "string" },
        "startAt": { "type": "string" },
        "endAt": { "type": "string" },
        "location": { "type": "string" },
        "participants": { "type": "string" },
        "pic": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "classId", "type", "startAt", "endAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "classId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "read": { "type": "boolean" },
        "link": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "category", "read"]
    },
    "Broadcast": {
      "title": "Broadcast",
      "description": "Broadcast announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "target": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "classId", "title", "content", "target", "senderId"]
    },
    "Document": {
      "title": "Document",
      "description": "Production documents and archives",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileSize": { "type": "string" },
        "fileType": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "uploaderName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "classId", "title", "category", "fileUrl"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Student complaint to teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "teacherResponse": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "classId", "title", "description", "category", "status"]
    },
    "PromptBook": {
      "title": "PromptBook",
      "description": "Digital prompt book with blocking and cues",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "scene": { "type": "string" },
        "gridPositions": { "type": "object" },
        "notes": { "type": "string" },
        "cues": { "type": "array" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "classId", "scene"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "role": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/classes/{classId}": {
      "schema": "Class",
      "description": "School classes"
    },
    "/productions/{productionId}": {
      "schema": "Production",
      "description": "Theater productions per class"
    },
    "/equipment/{equipmentId}": {
      "schema": "Equipment",
      "description": "School-wide equipment catalog"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Equipment booking with multi-alat sessions"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Production tasks"
    },
    "/deadlines/{deadlineId}": {
      "schema": "Task",
      "description": "Deadline items"
    },
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Assessment records"
    },
    "/attendanceSessions/{sessionId}": {
      "schema": "AttendanceSession",
      "description": "Attendance sessions"
    },
    "/attendanceRecords/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Attendance records"
    },
    "/schedules/{scheduleId}": {
      "schema": "Schedule",
      "description": "Production schedules"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/broadcasts/{broadcastId}": {
      "schema": "Broadcast",
      "description": "Broadcast announcements"
    },
    "/documents/{documentId}": {
      "schema": "Document",
      "description": "Production documents"
    },
    "/complaints/{complaintId}": {
      "schema": "Complaint",
      "description": "Student complaints"
    },
    "/promptBooks/{promptBookId}": {
      "schema": "PromptBook",
      "description": "Stage blocking"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit logs"
    }
  }
}